# Apache / cPanel configuration for Node.js Application
Options -Indexes

# Block direct web access to sensitive environment, git, and log files
<FilesMatch "^\.(env|git)|(\.log|\.sql|\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pass Authorization header to Node.js
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Phusion Passenger configuration (if cPanel Node.js App uses Passenger in this folder)
<IfModule mod_passenger.c>
  PassengerAppRoot "/home/USER/PATH_TO_APP"
  PassengerBaseURI "/"
  PassengerNodejs "/home/USER/nodevenv/PATH_TO_APP/20/bin/node"
  PassengerAppType node
  PassengerStartupFile app.js
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
