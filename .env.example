# ==============================================================================
# Environment Configuration for Royal Mansion Resort (cPanel & Production)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000

# Frontend & API URLs (Update with your actual domain or subdomain)
# If running API on a subdomain:
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Next.js Public API Base URL (Used by Frontend)
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# MySQL Database Connection (Separate Variables - Recommended)
# The application automatically constructs the connection string and handles special characters in passwords!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cpaneluser_dbadmin
DB_PASSWORD=YourDbPasswordHere123!
DB_NAME=cpaneluser_royalmansion

# Optional single-URL format (Legacy fallback):
# DATABASE_URL=mysql://cpaneluser_dbadmin:YourDbPasswordHere123!@127.0.0.1:3306/cpaneluser_royalmansion

# Application Secrets (Replace with random strings, min 16 characters)
SESSION_SECRET=replace_with_a_secure_random_session_secret_32_chars
CRON_SECRET=replace_with_a_secure_random_cron_secret_32_chars
MANAGE_BOOKING_TOKEN_SECRET=replace_with_a_secure_random_manage_secret_32_chars
ICAL_FEED_SECRET=replace_with_a_secure_random_ical_secret_32_chars

# Property Defaults
PROPERTY_TIMEZONE=Asia/Colombo
DEFAULT_CURRENCY=LKR
BOOKING_HOLD_MINUTES=15

# Payment Gateway (PayHere Sri Lanka)
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=https://api.yourdomain.com/api/v1/payments/payhere/notify
PAYHERE_RETURN_URL=https://yourdomain.com/booking/success
PAYHERE_CANCEL_URL=https://yourdomain.com/booking/cancel

# Email Notification Services (Optional: Resend)
RESEND_API_KEY=
EMAIL_FROM=reservations@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com
